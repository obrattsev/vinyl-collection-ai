COLLECTION_SPREADSHEET_ID=your-spreadsheet-id
COLLECTION_SHEET_NAME=Collection
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json
PORT=8000

# Configure both after creating the separate wishlist document. No local fallback.
WISHLIST_SPREADSHEET_ID=
WISHLIST_SHEET_NAME=

# Local only. Production requires NODE_ENV=production and an exact HTTPS APP_ORIGIN.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
# Required: provide OWNER_PASSWORD_HASH via an external env file; never the password.
# Generate with: node scripts/hash-owner-password.mjs /absolute/outside/repository/owner-auth.env
