COLLECTION_SPREADSHEET_ID=your-spreadsheet-id
COLLECTION_SHEET_NAME=Collection
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json
PORT=8000

# Configure both after creating the separate wishlist document. No local fallback.
WISHLIST_SPREADSHEET_ID=
WISHLIST_SHEET_NAME=

# Local only. Production requires NODE_ENV=production and an exact HTTPS APP_ORIGIN.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
# Required: provide OWNER_PASSWORD_HASH via an external env file; never the password.
# Generate with: node scripts/hash-owner-password.mjs /absolute/outside/repository/owner-auth.env

# Optional separate bug reports document (never a collection/wishlist document).
# BUG_REPORT_SPREADSHEET_ID=
# BUG_REPORT_SHEET_NAME=Bug Reports

# 3D: absolute persistent path outside releases; never store originals.
# Production target (configure only after approved schema + backup/restore preparation):
# COVERS_DIR=/var/lib/vinyl-collection-ai/covers

# Stage 4B: Sheets remains the default until separately approved cutover.
DATA_BACKEND=sheets
# Development/test; no implicit PG* fallback or dual-write.
# DATABASE_URL=postgresql://fixture_user:local_password@127.0.0.1:55464/vinyl_4a_acceptance_local
# PG_LOCAL_OWNER_ID=11111111-1111-4111-8111-111111111111
# Production path (never enable without cutover gates):
# NODE_ENV=production
# DATA_BACKEND=postgres
# PG_PRODUCTION_ACK=stage4b
# DATABASE_URL=postgresql://vinyl_app:REPLACE_ME@127.0.0.1:5432/vinyl_production
# PG_OWNER_ID=11111111-1111-4111-8111-111111111111
# MIRROR_ENABLED=true
# MIRROR_OWNER_ID=11111111-1111-4111-8111-111111111111
# MIRROR_COLLECTION_SPREADSHEET_ID=REPLACE_ME
# MIRROR_COLLECTION_SHEET_NAME=Collection
# MIRROR_WISHLIST_SPREADSHEET_ID=REPLACE_ME
# MIRROR_WISHLIST_SHEET_NAME=Wishlist
# Local fake only; do not combine with real mirror targets:
# MIRROR_FAKE_FILE=/absolute/private/mirror.json
# Backup tool PostgreSQL binary directory:
# PG_BIN=/usr/lib/postgresql/16/bin
